generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

enum GoalTransactionType {
  CONTRIBUTION
  WITHDRAWAL

  @@map("goal_transaction_type")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categories     Category[]
  transactions   Transaction[]
  spendingLimits SpendingLimit[]
  financialGoals FinancialGoal[]
  aiAnalyses     AiAnalysis[]

  @@map("users")
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String?         @map("user_id") @db.Uuid
  name      String          @db.VarChar(255)
  type      TransactionType
  isDefault Boolean         @default(false) @map("is_default")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions   Transaction[]
  spendingLimits SpendingLimit[]

  @@index([userId, type, isActive])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  categoryId  String          @map("category_id") @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(15, 2)
  date        DateTime        @db.Date
  description String?         @db.Text
  createdByAi Boolean         @default(false) @map("created_by_ai")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date, deletedAt])
  @@index([userId, categoryId, deletedAt])
  @@map("transactions")
}

model SpendingLimit {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  amount        Decimal   @db.Decimal(15, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  limitAlerts LimitAlert[]

  @@index([userId, categoryId, effectiveFrom, effectiveTo])
  @@map("spending_limits")
}

model FinancialGoal {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  name         String    @db.VarChar(255)
  targetAmount Decimal   @map("target_amount") @db.Decimal(15, 2)
  deadline     DateTime? @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  goalTransactions GoalTransaction[]

  @@index([userId, deletedAt])
  @@map("financial_goals")
}

model GoalTransaction {
  id          String              @id @default(uuid()) @db.Uuid
  goalId      String              @map("goal_id") @db.Uuid
  type        GoalTransactionType
  amount      Decimal             @db.Decimal(15, 2)
  date        DateTime            @db.Date
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([goalId, deletedAt])
  @@map("goal_transactions")
}

model AiAnalysis {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  referenceMonth Int      @map("reference_month")
  referenceYear  Int      @map("reference_year")
  analysisData   Json     @map("analysis_data")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, referenceYear, referenceMonth])
  @@map("ai_analyses")
}

model LimitAlert {
  id              String   @id @default(uuid()) @db.Uuid
  spendingLimitId String   @map("spending_limit_id") @db.Uuid
  referenceMonth  Int      @map("reference_month")
  referenceYear   Int      @map("reference_year")
  threshold       Int
  createdAt       DateTime @default(now()) @map("created_at")

  spendingLimit SpendingLimit @relation(fields: [spendingLimitId], references: [id], onDelete: Restrict)

  @@unique([spendingLimitId, referenceMonth, referenceYear, threshold])
  @@map("limit_alerts")
}
